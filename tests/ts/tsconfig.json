{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["stubs/panel/*"],
      "@blueprint/*": ["stubs/blueprint/*"],
      "react": ["node_modules/@types/react"]
    },
    "types": ["node", "react"]
  },
  "include": ["../../batchupdate/components/**/*.ts", "../../batchupdate/components/**/*.tsx", "stubs/**/*.d.ts", "*.test.ts"]
}
